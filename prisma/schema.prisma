// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MEMBER
  NEUTRAL
}

model User {
  id                String   @id @default(cuid())
  name              String
  email             String?  @unique
  mobile            String?
  username          String   @unique
  passwordHash      String
  role              Role     @default(MEMBER)
  profilePhoto      String?
  totalPoints       Int      @default(0)
  lastActive        DateTime? @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  worksCreated      Work[]          @relation("WorkCreator")
  worksOriginal     Work[]          @relation("WorkOriginalOwner")
  worksEdited       Work[]          @relation("WorkEditor")
  worksAssigned     Work[]          @relation("WorkAssignees")
  workUpdates       WorkUpdate[]
  activityLogs      ActivityLog[]
  communityPosts    CommunityPost[]
  dailyUpdates      DailyUpdate[]
  chatMessages      ChatMessage[]
  typingStates      TypingState[]
  ideaSupports      IdeaSupport[]
  notes             Note[]
  notifications     Notification[]
  
  ideaDisagrees     IdeaDisagree[]
  disagreeReplies   IdeaDisagreeReply[]
  
  // Mention & Points System
  pointsEarned      PointTransaction[]
  personMentions    PersonMention[]
  timeLogs          TimeLog[]
}

model Work {
  id              String   @id @default(cuid())
  name            String
  description     String   @db.Text
  status          String   @default("IDEA") // IDEA, ACTIVE, BLOCKED, COMPLETED, ARCHIVED
  priority        String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  dueDate         DateTime?
  blockedReason   String?  @db.Text
  
  // Relations
  creatorId       String
  creator         User     @relation("WorkCreator", fields: [creatorId], references: [id])
  
  assignees       User[]   @relation("WorkAssignees")

  workUpdates     WorkUpdate[]
  
  // For admin edits
  originalOwnerId String?
  originalOwner   User?    @relation("WorkOriginalOwner", fields: [originalOwnerId], references: [id])
  editedByAdminId String?
  editedByAdmin   User?    @relation("WorkEditor", fields: [editedByAdminId], references: [id])
  editReason      String?  @db.Text

  expectedDurationHours Int?
  ideaPointsAwarded Boolean @default(false)

  supports        IdeaSupport[]
  disagrees       IdeaDisagree[]

  // Mention & Points System
  parentWorkId    String?
  parentWork      Work?    @relation("WorkToSubWorks", fields: [parentWorkId], references: [id])
  subWorks        Work[]   @relation("WorkToSubWorks")
  personMentions  PersonMention[]
  timeLogs        TimeLog[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  activityLogs    ActivityLog[]
}

model ActivityLog {
  id          String   @id @default(cuid())
  action      String   // CREATED, UPDATED, ARCHIVED, STATUS_CHANGE
  details     String?  @db.Text
  
  workId      String?
  work        Work?    @relation(fields: [workId], references: [id], onDelete: SetNull)
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
}

model CommunityPost {
  id          String   @id @default(cuid())
  content     String   @db.Text
  type        String   // UPDATE, THOUGHT, IDEA, PROGRESS
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
}

model DailyUpdate {
  id           String   @id @default(cuid())
  whatChanged  String   @db.Text
  whatImproved String   @db.Text
  whatFixed    String   @db.Text
  
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
}

model ChatMessage {
  id        String      @id @default(cuid())
  message   String      @db.Text
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId String
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
}

model ChatChannel {
  id          String        @id @default(cuid())
  name        String
  description String?       @db.Text
  isProject   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  messages    ChatMessage[]
  typingStates TypingState[]
}

model TypingState {
  userId    String      @id
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId String
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  updatedAt DateTime    @updatedAt
}

model WorkUpdate {
  id        String   @id @default(cuid())
  content   String   @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workId    String
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model IdeaSupport {
  id        String   @id @default(cuid())
  workId    String
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([workId, userId])
}

model IdeaDisagree {
  id        String   @id @default(cuid())
  reason    String   @db.Text
  workId    String
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  replies   IdeaDisagreeReply[]
  
  @@unique([workId, userId])
}

model IdeaDisagreeReply {
  id          String   @id @default(cuid())
  content     String   @db.Text
  disagreeId  String
  disagree    IdeaDisagree @relation(fields: [disagreeId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model Note {
  id          String    @id @default(cuid())
  title       String
  content     String    @db.Text
  color       String    @default("#63BDF2")
  reminderAt  DateTime?
  
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Notification {
  id          String   @id @default(cuid())
  title       String
  message     String   @db.Text
  type        String   @default("INFO") // INFO, WARNING, REMINDER, BLOCKER
  isRead      Boolean  @default(false)
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------
// Mention & Points System Models
// ---------------------------------------------------------

model PointTransaction {
  id        String   @id @default(cuid())
  amount    Int
  reason    String   // "PERSON_MENTION", "WORK_MENTION", "TIME_LOG"
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  workId    String?  // Optional reference to which work granted the points
  
  createdAt DateTime @default(now())
}

model PersonMention {
  id        String   @id @default(cuid())
  
  workId    String
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  pointsAwarded Boolean @default(false)
  createdAt DateTime @default(now())

  @@unique([workId, userId])
}

model TimeLog {
  id        String   @id @default(cuid())
  hours     Int
  points    Int
  
  workId    String
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
}
